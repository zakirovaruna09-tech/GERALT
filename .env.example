# ══════════════════════════════════════════════════════════════════════
#  GERALT — шаблон переменных окружения
#  Скопируй этот файл в .env и заполни своими данными:
#       copy .env.example .env
#  Файл .env НЕ коммитится в git (см. .gitignore).
# ══════════════════════════════════════════════════════════════════════

# ── TELEGRAM ──────────────────────────────────────────────────────────
# Получить у @BotFather → /newbot
BOT_TOKEN=

# Твой Telegram user ID — узнать у @userinfobot
OWNER_ID=

# ── GMAIL ─────────────────────────────────────────────────────────────
GMAIL=
# Google Account → Security → App Passwords (16 символов)
GMAIL_APP_PASS=

# ── HUGGING FACE (анализ/генерация фото) ─────────────────────────────
# https://huggingface.co/settings/tokens
HF_TOKEN=

# ── GEMINI / GOOGLE (опционально) ────────────────────────────────────
GEMINI_KEY=
GOOGLE_API_KEY=

# ── ПРОЧИЕ НАСТРОЙКИ (необязательно) ─────────────────────────────────
# WEATHER_CITY=Tashkent
# JARVIS_DIR=D:\Geralt

# ══════════════════════════════════════════════════════════════════════
#  LEGACY — только если используешь старый main.py (v5.2)
# ══════════════════════════════════════════════════════════════════════
# BOT_TOKEN_LEGACY=
# GMAIL_APP_PASS_LEGACY=
# HF_TOKEN_LEGACY=
